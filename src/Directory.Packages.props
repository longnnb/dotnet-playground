<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Firely FHIR SDK. Deliberately held at the latest 5.x (not 6.x, which has breaking
             API changes) so the FhirService rewrite can be judged on its own merits against a
             stable package surface. Revisit as its own follow-up. -->
        <PackageVersion Include="Hl7.Fhir.R4" Version="5.13.4" />

        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />

        <!-- Kept alongside Http.Resilience on purpose: the old Polly-v7-based retry pipeline
             next to the new Polly-v8-based one is one of the more useful side-by-side
             comparisons in the HttpClientTest project. Not formally deprecated on NuGet and
             still ships in step with the runtime. -->
        <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />

        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />

        <PackageVersion Include="Scrutor" Version="7.0.0" />
    </ItemGroup>

</Project>
