<Project>

    <PropertyGroup>
        <!-- Single knob for the whole playground. Each csproj writes
             <TargetFramework>$(PlaygroundTfm)</TargetFramework> (or "$(PlaygroundTfm)-windows"
             for the WPF project) explicitly, rather than this file setting TargetFramework
             directly. That keeps every csproj self-describing and lets the WPF project stay
             coupled to the one shared value instead of hardcoding a parallel literal. -->
        <PlaygroundTfm>net10.0</PlaygroundTfm>

        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Activates CS1591 (missing XML doc on a publicly visible member). Combined with
             TreatWarningsAsErrors below, this makes documentation a build requirement instead
             of a good intention: the only automated enforcement available in a repo with no
             test projects. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>

        <!-- The compiler is the only automated safety net a repo with no test projects has, so
             it's turned all the way up: every warning is a build error. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- CA1848 ("use LoggerMessage delegates for high-performance logging") and CA1873
             ("expensive argument evaluation for a possibly-disabled log level") are correct
             guidance for production hot paths; in these demos they're just noise on every
             Console/ILogger call, none of which is ever on a hot path.

             CA1859 ("use the concrete type instead of the interface for improved performance")
             and CA1822 ("member does not access instance data, mark it static") actively fight
             what several of these projects are teaching: DesignPatterns and Decorator declare
             variables typed as an abstraction on purpose (that's the pattern), and their example
             services are instance methods on purpose (a real InventoryService/PaymentService
             would hold instance state like a DB connection; that these toy versions don't need
             any is an artifact of being a demo, not a reason to make the methods static). -->
        <NoWarn>$(NoWarn);CA1848;CA1873;CA1859;CA1822</NoWarn>
    </PropertyGroup>

</Project>
